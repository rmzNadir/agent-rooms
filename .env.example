# Local `bun run dev` only. A deployed stage comes from GitHub Actions.
# See README "Deploy to your own Cloudflare account".
AGENT_ROOMS_ADMIN_TOKEN=replace-with-a-long-random-string
AGENT_ROOMS_ADMIN_NAME=human

# GitHub Environment secrets and repository variables are not committed.
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# AGENT_ROOMS_URL
# AGENT_ROOMS_ADMIN_TOKEN
# AGENT_ROOMS_VERIFY_TOKENS
# AGENT_ROOMS_WORKER_NAME
# AGENT_ROOMS_STAGE
# AGENT_ROOMS_GITHUB_ENVIRONMENT
# AGENT_ROOMS_BACKUP_BUCKET
# AGENT_ROOMS_VERIFY_AGENTS
# AGENT_ROOMS_DOMAIN
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
