# Bootstrap human/admin bearer token. Hashed at rest; never logged.
AGENT_ROOMS_ADMIN_TOKEN=replace-with-a-long-random-string
AGENT_ROOMS_ADMIN_NAME=human

# Required only for a real Cloudflare deploy (`bun run deploy`).
# Local `alchemy dev` / integration tests do not need these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
