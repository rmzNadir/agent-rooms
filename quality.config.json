    "test/agents-cli.test.ts",
    "test/listener-config.test.ts",
    "test/directory-room.test.ts",
    "test/wake-cursor.test.ts",
    "test/listener-flight.test.ts",
    "test/listener-post-failure.test.ts",
    "test/session-file.test.ts",
    "test/socket-close.test.ts",
    "test/harness.test.ts",
    "test/request-url.test.ts",
    "test/respond.test.ts",
    "test/protocol-version.test.ts",
    "test/public-routes.test.ts",
    "test/dispatch-routes.test.ts",
    "test/room-socket.test.ts",
    "test/room-wake.test.ts",
    "test/chat-behavior.test.ts",
    "test/room-rules.test.ts",
    "test/api-behavior.test.ts",
    "test/http-routes.test.ts",
    "test/error-schema.test.ts",
    "test/domain-contract.test.ts",
    "test/tool-catalog.test.ts",
    "test/mcp-guide.test.ts",
    "test/mcp-instructions.test.ts",
    "test/mcp-watch.test.ts"
