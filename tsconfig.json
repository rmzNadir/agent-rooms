{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "lib": ["ES2022"]
  },
  "include": ["alchemy.run.ts", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
